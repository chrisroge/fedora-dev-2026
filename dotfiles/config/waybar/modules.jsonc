// Shared Waybar controls; workspace numbers stay visible on every output.
{
  "layer": "top",
  "position": "top",
  "height": 44,
  "margin-top": 8,
  "margin-left": 10,
  "margin-right": 10,
  "margin-bottom": 0,
  "spacing": 6,
  "reload_style_on_change": true,
  "modules-left": [
    "custom/display",
    "hyprland/workspaces"
  ],
  "modules-center": [
    "hyprland/window"
  ],
  "modules-right": [
    "group/session",
    "pulseaudio",
    "network",
    "group/telemetry",
    "group/power",
    "clock",
    "tray"
  ],
  "group/session": {
    "orientation": "horizontal",
    "modules": [
      "custom/cheatsheet",
      "idle_inhibitor",
      "custom/ghostty-theme"
    ]
  },
  "group/telemetry": {
    "orientation": "horizontal",
    "modules": [
      "cpu",
      "memory",
      "temperature"
    ]
  },
  "group/power": {
    "orientation": "horizontal",
    "modules": [
      "power-profiles-daemon",
      "backlight",
      "battery"
    ]
  },
  // Per-display persistent workspaces are generated into config.jsonc by
  // hypr-monitors; these defaults apply to every bar.
  "hyprland/workspaces": {
    "on-click": "activate",
    "sort-by-number": true,
    "all-outputs": false,
    "format": "{name}"
  },
  "custom/cheatsheet": {
    "format": "",
    "tooltip-format": "Keyboard shortcuts · SUPER + /",
    "on-click": "__HOME__/.local/bin/hypr-cheatsheet"
  },
  "hyprland/window": {
    "max-length": 32,
    "separate-outputs": true,
    "swap-icon-label": false
  },
  "custom/ghostty-theme": {
    "exec": "__HOME__/.local/bin/ghostty-theme status",
    "return-type": "json",
    "format": "{icon}",
    "on-click": "__HOME__/.local/bin/ghostty-theme toggle",
    "interval": "once",
    "signal": 8,
    "tooltip": true,
    "format-icons": {
      "light": "",
      "dark": "",
      "default": ""
    },
    "hide-empty-text": false
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    },
    "tooltip-format-activated": "Keep awake: on · click to allow idle",
    "tooltip-format-deactivated": "Keep awake: off · click to inhibit idle"
  },
  "pulseaudio": {
    "format": "{icon} {volume}% {format_source}",
    "format-bluetooth": "{icon} {volume}%  {format_source}",
    "format-muted": " {format_source}",
    "format-bluetooth-muted": "  {format_source}",
    "format-source": "",
    "format-source-muted": "",
    "format-icons": {
      "headphone": "",
      "headset": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "pavucontrol",
    "scroll-step": 2,
    "tooltip-format": "{desc}\nVolume: {volume}% · click for mixer"
  },
  "network": {
    "format-wifi": " {signalStrength}%",
    "format-ethernet": " LAN",
    "format-linked": " …",
    "format-disconnected": " Offline",
    "tooltip-format-wifi": "{essid} · {signalStrength}%\n{ifname} · {ipaddr}",
    "tooltip-format-ethernet": "{ifname} · {ipaddr}/{cidr}",
    "tooltip-format-disconnected": "Network disconnected"
  },
  "cpu": {
    "format": " {usage}%",
    "interval": 3,
    "tooltip-format": "CPU · {usage}%\nClick to open btop",
    "on-click": "ghostty -e btop"
  },
  "memory": {
    "format": " {percentage}%",
    "interval": 5,
    "tooltip-format": "Memory · {used:0.1f} / {total:0.1f} GiB"
  },
  "temperature": {
    "critical-threshold": 80,
    "format": " {temperatureC}°",
    "tooltip-format": "Temperature · {temperatureC}°C"
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    },
    "tooltip-format": "Power: {profile}\nClick to change profile"
  },
  "backlight": {
    "format": " {percent}%",
    "tooltip-format": "Display brightness · {percent}%"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-full": " {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-alt": "{icon} {time}",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "tooltip-format": "Battery · {capacity}%\n{timeTo}"
  },
  "clock": {
    "format": "{:%a %d  ·  %I:%M %p}",
    "format-alt": "{:%B %d, %Y}",
    "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  }
}
