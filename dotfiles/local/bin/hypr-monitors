#!/usr/bin/env python3
"""Pin workspaces to monitors by role, for whatever monitors are connected.

Roles are assigned in order: the built-in panel first, then external displays
from largest to smallest (ties broken left to right).

    role     workspaces            keys (focus / move window)   Waybar label
    home     1-4   and 11-14       SUPER+CTRL+G / SUPER+SHIFT+G  HOME
    studio   5-8   and 15-18       SUPER+CTRL+F / SUPER+SHIFT+F  STUDIO
    read     9-10  and 19-20       SUPER+CTRL+D / SUPER+SHIFT+D  READ

A laptop on its own is "home"; workspaces of absent roles simply open on the
focused monitor. A fourth display or beyond gets a bar but no pinned block.

Generated:  ~/.config/hypr/monitors.lua      (loaded by hyprland.lua)
            ~/.config/waybar/config.jsonc    (one bar per display)
Per-machine: ~/.config/hypr/monitors.json    (mode/position/scale/transform
            per output; never overwritten — `hypr-monitors --save` snapshots
            the current arrangement into it)

hyprland.lua runs this on startup and on every monitor hotplug.
"""
import argparse
import fcntl
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import time

CONFIG = Path(os.environ.get('XDG_CONFIG_HOME', Path.home() / '.config'))
HYPR = CONFIG / 'hypr'
WAYBAR = CONFIG / 'waybar'
OVERRIDES = HYPR / 'monitors.json'

INTERNAL_PREFIXES = ('eDP-', 'LVDS-', 'DSI-')

# (role, waybar bar name / CSS class, label, workspaces, focus/move key)
ROLES = [
    ('home',   'laptop',   'HOME',   [1, 2, 3, 4, 11, 12, 13, 14],      'G'),
    ('studio', 'studio',   'STUDIO', [5, 6, 7, 8, 15, 16, 17, 18],      'F'),
    ('read',   'portrait', 'READ',   [9, 10, 19, 20],                   'D'),
]
ICON_LAPTOP, ICON_DESKTOP, ICON_READ = '', '', ''


def run(*args):
    return subprocess.run(args, text=True, capture_output=True, check=True).stdout


def atomic(path, text):
    """Write path only if its content changes; report whether it did."""
    if path.exists() and path.read_text() == text:
        return False
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=path.name + '.', dir=path.parent)
    try:
        with os.fdopen(fd, 'w') as f:
            f.write(text)
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)
    return True


def in_session():
    return bool(os.environ.get('HYPRLAND_INSTANCE_SIGNATURE'))


def connected_monitors():
    """Active monitors from Hyprland, or [] outside a Hyprland session."""
    if not in_session():
        return []
    try:
        return [m for m in json.loads(run('hyprctl', '-j', 'monitors'))
                if not m.get('disabled')]
    except (subprocess.CalledProcessError, json.JSONDecodeError, OSError):
        return []


def assign_roles(monitors):
    """Return [(role_tuple_or_None, monitor)] in role order."""
    internal = [m for m in monitors if m['name'].startswith(INTERNAL_PREFIXES)]
    external = [m for m in monitors if m not in internal]
    external.sort(key=lambda m: (-(m['width'] * m['height']), m['x']))
    ordered = sorted(internal, key=lambda m: m['x']) + external
    return [(ROLES[i] if i < len(ROLES) else None, m) for i, m in enumerate(ordered)]


def read_overrides():
    if not OVERRIDES.exists():
        return {}
    data = json.loads(OVERRIDES.read_text())
    outputs = data.get('outputs', {})
    if not isinstance(outputs, dict):
        raise ValueError(f'{OVERRIDES}: "outputs" must be an object')
    return outputs


def lua_value(v):
    if isinstance(v, bool):
        return 'true' if v else 'false'
    if isinstance(v, (int, float)):
        return repr(v)
    return json.dumps(str(v))


def render_lua(assigned, overrides):
    lines = ['-- Generated by hypr-monitors. Per-machine overrides: monitors.json.',
             '-- Fallback first, so the per-output entries below win.',
             'hl.monitor({ output = "", mode = "preferred", position = "auto", scale = "auto" })']
    for name, spec in sorted(overrides.items()):
        fields = {'output': name, **{k: spec[k] for k in ('mode', 'position', 'scale', 'transform') if k in spec}}
        lines.append('hl.monitor({ ' + ', '.join(f'{k} = {lua_value(v)}' for k, v in fields.items()) + ' })')

    present = {}
    for role, m in assigned:
        if role is None:
            continue
        name, _, _, workspaces, key = role
        present[name] = m['name']
        lines.append(f'-- {name}: {m["name"]} ({m.get("make", "")} {m.get("model", "")})'.rstrip())
        for i, ws in enumerate(workspaces):
            default = ', default = true' if i == 0 else ''
            lines.append(f'hl.workspace_rule({{ workspace = "{ws}", monitor = "{m["name"]}"{default} }})')
        label = role[2]
        lines.append(f'hl.bind("SUPER + CTRL + {key}", hl.dsp.focus({{ monitor = "{m["name"]}" }}), '
                     f'{{ description = "Monitors: Focus {label} ({m["name"]})" }})')
        lines.append(f'hl.bind("SUPER + SHIFT + {key}", hl.dsp.window.move({{ monitor = "{m["name"]}" }}), '
                     f'{{ description = "Monitors: Move window to {label} ({m["name"]})" }})')
    if 'studio' in present and 'read' in present:
        lines.append('hl.bind("SUPER + ALT + S", hl.dsp.workspace.swap_monitors({ monitor1 = "%s", monitor2 = "%s" }), '
                     '{ description = "Monitors: Swap READ and STUDIO workspaces" })'
                     % (present['read'], present['studio']))
    return '\n'.join(lines) + '\n'


def render_waybar(assigned):
    include = str(WAYBAR / 'modules.jsonc')
    if not assigned:
        # Outside Hyprland (first install): one bar on every output until the
        # first login regenerates this per display.
        bars = [{'name': 'laptop', 'include': include,
                 'custom/display': {'format': f'{ICON_LAPTOP}  HOME'}}]
    else:
        bars = []
        for role, m in assigned:
            if role is None:
                bars.append({'name': 'studio', 'output': m['name'], 'include': include,
                             'custom/display': {'format': f'{ICON_DESKTOP}  {m["name"]}',
                                                'tooltip-format': 'Unpinned display'}})
                continue
            name, css, label, workspaces, _ = role
            icon = {'home': ICON_LAPTOP if m['name'].startswith(INTERNAL_PREFIXES) else ICON_DESKTOP,
                    'studio': ICON_DESKTOP, 'read': ICON_READ}[name]
            ws_text = ', '.join(f'{a}–{b}' if a != b else str(a) for a, b in _ranges(workspaces))
            bar = {'name': css, 'output': m['name'], 'include': include,
                   'custom/display': {'format': f'{icon}  {label}',
                                      'tooltip-format': f'{m["name"]} · workspaces {ws_text}'},
                   'hyprland/workspaces': {'on-click': 'activate', 'sort-by-number': True,
                                           'all-outputs': False, 'format': '{name}',
                                           'persistent-workspaces': {m['name']: workspaces}}}
            if name == 'read':
                # The third display gets the compact bar: no window title,
                # shorter clock.
                bar['modules-center'] = []
                bar['clock'] = {'format': '{:%I:%M %p}', 'format-alt': '{:%b %d}'}
            bars.append(bar)
    header = '// Generated by hypr-monitors — one bar per display. Shared controls: modules.jsonc.\n'
    return header + json.dumps(bars, indent=2, ensure_ascii=False) + '\n'


def _ranges(nums):
    start = prev = nums[0]
    for n in nums[1:]:
        if n != prev + 1:
            yield start, prev
            start = n
        prev = n
    yield start, prev


def move_misplaced_workspaces(assigned):
    """Rules only place new workspaces; move existing ones onto their monitor."""
    target = {ws: m['name'] for role, m in assigned if role for ws in role[3]}
    for ws in json.loads(run('hyprctl', '-j', 'workspaces')):
        want = target.get(ws['id'])
        if want and ws['monitor'] != want:
            run('hyprctl', 'eval',
                f'hl.dispatch(hl.dsp.workspace.move({{ workspace = "{ws["id"]}", monitor = "{want}" }}))')


def save_overrides(monitors):
    outputs = read_overrides()
    for m in monitors:
        outputs[m['name']] = {'mode': f'{m["width"]}x{m["height"]}@{round(m["refreshRate"])}',
                              'position': f'{m["x"]}x{m["y"]}',
                              'scale': m['scale'], 'transform': m['transform']}
    atomic(OVERRIDES, json.dumps({'outputs': outputs}, indent=2) + '\n')
    print(f'Saved {len(monitors)} output(s) to {OVERRIDES}')


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument('--render', action='store_true', help='Write files only; no reload (used by the installer)')
    p.add_argument('--settle', action='store_true', help='Wait a moment first (hotplug events)')
    p.add_argument('--list', action='store_true', help='Print the role assignment as JSON')
    p.add_argument('--save', action='store_true', help='Snapshot the current arrangement into monitors.json')
    args = p.parse_args()

    HYPR.mkdir(parents=True, exist_ok=True)
    with (HYPR / '.monitors.lock').open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if args.settle:
            time.sleep(1)
        monitors = connected_monitors()
        assigned = assign_roles(monitors)

        if args.list:
            print(json.dumps([{'role': r[0] if r else None, 'output': m['name'],
                               'workspaces': r[3] if r else []} for r, m in assigned], indent=2))
            return
        if args.save:
            if not monitors:
                raise RuntimeError('Run --save inside a Hyprland session.')
            save_overrides(monitors)

        lua_changed = atomic(HYPR / 'monitors.lua', render_lua(assigned, read_overrides()))
        bar_changed = atomic(WAYBAR / 'config.jsonc', render_waybar(assigned))
        if args.render or not in_session():
            return
        if lua_changed:
            run('hyprctl', 'reload')
            errors = run('hyprctl', 'configerrors').strip()
            if errors:
                raise RuntimeError('Hyprland rejected monitors.lua: ' + errors)
        move_misplaced_workspaces(assigned)
        if bar_changed:
            subprocess.run(['pkill', '-USR2', '-x', 'waybar'], check=False)


if __name__ == '__main__':
    try:
        main()
    except (ValueError, RuntimeError, OSError, subprocess.CalledProcessError) as e:
        print(f'hypr-monitors: {e}', file=sys.stderr)
        subprocess.run(['notify-send', 'Hyprland monitors', str(e)], check=False)
        sys.exit(1)
