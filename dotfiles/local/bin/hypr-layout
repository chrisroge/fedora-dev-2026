#!/usr/bin/env python3
"""Persistent Hyprland layout preferences; also usable by a future TUI."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile

CONFIG = Path(os.environ.get('XDG_CONFIG_HOME', Path.home() / '.config')) / 'hypr'
COLUMNS = {'two-columns': 2, 'three-columns': 3, 'four-columns': 4}
CHOICES = {'dwindle': 'dwindle', **{name: 'scrolling' for name in COLUMNS}}

def run(*args):
    return subprocess.run(args, text=True, capture_output=True, check=True).stdout.strip()

def atomic(path, text):
    fd, tmp = tempfile.mkstemp(prefix=path.name+'.', dir=path.parent)
    try:
        with os.fdopen(fd, 'w') as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp): os.unlink(tmp)

def read_settings():
    path = CONFIG / 'layouts.json'
    settings = json.loads(path.read_text()) if path.exists() else {'default': 'dwindle', 'workspaces': {}}
    if settings.get('default') not in CHOICES or not isinstance(settings.get('workspaces'), dict):
        raise ValueError('Invalid layouts.json')
    for ws, layout in settings['workspaces'].items():
        if not ws.isdigit() or int(ws) < 1 or layout not in CHOICES:
            raise ValueError('Invalid workspace layout preference')
    return settings

def render(settings):
    default_columns = COLUMNS.get(settings['default'], 0)
    lines = ['-- Generated by hypr-layout. Edit preferences with that command.',
             'hl.config({ general = { layout = "'+CHOICES[settings['default']]+'" },',
             '  scrolling = { column_width = '+str(1/(default_columns or 2))+',',
             '    fullscreen_on_one_column = true, follow_focus = true, focus_fit_method = 1 } })',
             'local default_columns = '+str(default_columns),
             'local workspace_columns = {}',
             'hl.window_rule({ name = "column-width-default", match = { class = ".*" },',
             '  scrolling_width = '+str(1/(default_columns or 2))+' })']
    for ws, layout in sorted(settings['workspaces'].items(), key=lambda x: int(x[0])):
        lines.append('hl.workspace_rule({ workspace = "'+ws+'", layout = "'+CHOICES[layout]+'" })')
        count = COLUMNS.get(layout, 0)
        lines.append('workspace_columns['+ws+'] = '+str(count))
        if count:
            lines.append('hl.window_rule({ name = "column-width-'+ws+'", match = { workspace = "'+ws+'" }, scrolling_width = '+str(1/count)+' })')
    lines.append('''
-- Width rules size newly opened windows. Reconcile existing windows when a
-- workspace is activated or preferences reload, without changing focus.
-- Hyprland 0.56's native column_width setting is global, so workspace profiles
-- also need this hook. The native scrolling layout handles overflow and focus.
local function apply_column_widths()
    local window = hl.get_active_window()
    if not window or window.floating or not window.workspace then return end
    local workspace = window.workspace
    local count = workspace_columns[workspace.id]
    if count == nil then count = default_columns end
    if count == 0 or workspace.tiled_layout ~= "scrolling" then return end
    local needs_resize = false
    for _, candidate in ipairs(workspace:get_windows()) do
        local layout = candidate.layout
        if layout and layout.column and math.abs(layout.column.width - 1 / count) > 0.00001 then
            needs_resize = true
            break
        end
    end
    if not needs_resize then return end
    local width = tostring(1 / count)
    -- Reset the old camera offset before resizing, so switching from two to
    -- four columns does not leave empty space beyond the end of the tape.
    hl.dispatch(hl.dsp.layout("fit all"))
    hl.dispatch(hl.dsp.layout("colresize all " .. width))
    -- Keep the focused column visible after changing the width.
    hl.dispatch(hl.dsp.layout("colresize " .. width))
end
hl.on("window.active", apply_column_widths)
hl.on("window.open", apply_column_widths)
hl.on("window.move_to_workspace", apply_column_widths)
hl.on("workspace.active", apply_column_widths)
hl.on("config.reloaded", apply_column_widths)
''')
    return '\n'.join(lines)+'\n'

def modern_session():
    version = json.loads(run('hyprctl', '-j', 'version'))
    match = re.search(r'(\d+)\.(\d+)', version.get('version', '') or version.get('tag', ''))
    return bool(match and tuple(map(int, match.groups())) >= (0, 55))

def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('layout', nargs='?', choices=['inherit', *CHOICES])
    p.add_argument('workspace', nargs='?', type=int, help='Defaults to the focused workspace')
    p.add_argument('--default', dest='default_layout', choices=CHOICES, help='Change the inherited default')
    p.add_argument('--list', action='store_true', help='Print preferences as JSON')
    p.add_argument('--menu', action='store_true', help='Choose the focused workspace layout')
    p.add_argument('--render', action='store_true', help='Regenerate Lua without reloading')
    args = p.parse_args()
    CONFIG.mkdir(parents=True, exist_ok=True)
    with (CONFIG / '.layouts.lock').open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        settings = read_settings()
        if args.list:
            print(json.dumps(settings, indent=2)); return
        if args.render:
            atomic(CONFIG/'layouts.lua', render(settings)); return
        if not (args.layout or args.menu or args.default_layout): p.print_help(); return
        if not modern_session():
            raise RuntimeError('Layout selection needs the upgraded session. Log out and back into Hyprland first.')
        if args.menu:
            args.workspace = json.loads(run('hyprctl', '-j', 'activeworkspace'))['id']
            current = settings['workspaces'].get(str(args.workspace), 'inherit')
            labels = {'inherit': 'Inherit default ('+settings['default']+')',
                      'dwindle': 'Dwindle', 'two-columns': '2 full-height columns',
                      'three-columns': '3 full-height columns', 'four-columns': '4 full-height columns'}
            choices = {label+('  [current]' if key==current else ''):key for key,label in labels.items()}
            result = subprocess.run(['wofi','--dmenu','--prompt',f'Workspace {args.workspace} layout',
                                     '--width','460','--height','320'],input='\n'.join(choices),text=True,capture_output=True)
            if result.returncode: return
            args.layout = choices.get(result.stdout.strip())
            if not args.layout: return
        if args.default_layout:
            settings['default'] = args.default_layout
        else:
            ws = args.workspace if args.workspace is not None else json.loads(run('hyprctl','-j','activeworkspace'))['id']
            if ws < 1: raise ValueError('Select a regular workspace; special workspaces keep the default.')
            if args.layout == 'inherit': settings['workspaces'].pop(str(ws), None)
            else: settings['workspaces'][str(ws)] = args.layout
        paths = [CONFIG/'layouts.lua', CONFIG/'layouts.json']
        saved = {p: p.read_text() if p.exists() else None for p in paths}
        try:
            atomic(paths[0], render(settings))
            atomic(paths[1], json.dumps(settings, indent=2)+'\n')
            run('hyprctl','reload')
            errors = run('hyprctl','configerrors')
            if errors: raise RuntimeError('Hyprland rejected the configuration: '+errors)
        except Exception:
            for path, text in saved.items():
                if text is None: path.unlink(missing_ok=True)
                else: atomic(path, text)
            subprocess.run(['hyprctl','reload'],capture_output=True)
            raise
        print('Default: '+settings['default'] if args.default_layout else f'Workspace {ws}: {args.layout}')

if __name__ == '__main__':
    try: main()
    except (ValueError, RuntimeError, OSError, subprocess.CalledProcessError) as e:
        print(str(e), file=sys.stderr)
        if '--menu' in sys.argv:
            subprocess.run(['notify-send','Hyprland layouts',str(e)],check=False)
        sys.exit(1)
